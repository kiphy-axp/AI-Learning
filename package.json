{
  "name": "ai-algo-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向 AI 算法开发岗的本地学习站：16 个阶段、160+ 知识点、本地 SQLite 进度、AI Tutor",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "api": "node server/index.mjs",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.mjs",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.454.0",
