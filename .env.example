# ============================================================
# AI 算法实验室 · 本地学习站 —— 环境配置模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会上传。
# ============================================================

# ---------- AI 导师模型接口（OpenAI 兼容） ----------
# 不配置也能用：导师会自动切换为基于课程内容的离线讲解。
# 支持 TUTOR_* 命名；也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL。
TUTOR_PROVIDER=opencode-go
TUTOR_BASE_URL=https://opencode.ai/zen/go/v1
TUTOR_MODEL=deepseek-v4-flash
TUTOR_API_KEY=sk-replace-with-your-own-key

# ---------- 其他常用服务商（任选其一替换上面四行） ----------
# DeepSeek      https://api.deepseek.com/v1              deepseek-chat
# OpenAI        https://api.openai.com/v1                gpt-4o-mini
# OpenRouter    https://openrouter.ai/api/v1             anthropic/claude-3.5-sonnet
# 本地 Ollama   http://127.0.0.1:11434/v1                qwen2.5:14b        （Key 随便填，如 ollama）

# ---------- 服务端口（可选） ----------
# PORT=4173
# HOST=127.0.0.1
